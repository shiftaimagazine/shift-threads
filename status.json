      "items": [
       {
        "h": "할 일을 있는 대로 나열",
        "d": "정리 안 해도 괜찮아요"
       },
       {
        "h": "급함·중요함으로 나누기",
        "d": "무엇부터 할지 보여요"
       },
       {
        "h": "오전/오후 시간표 요청",
        "d": "예상 시간도 같이"
       },
       {
        "h": "미루면 안 되는 일 1개 표시",
