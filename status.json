    "type": "carousel",
    "hook": "자료 50개를 올려 두고, 그 안에서만 답하게 할 수 있어요. 구글 Gemini Notebook(노트북LM)은",
    "status": "scheduled",
    "link": null,
    "cards": [
     "https://raw.githubusercontent.com/shiftaimagazine/shift-threads/main/media/2026-11-21-1141-howto/01.png",
     "https://raw.githubusercontent.com/shiftaimagazine/shift-threads/main/media/2026-11-21-1141-howto/02.png"
    ],
    "views": null,
    "likes": null,
    "replies": null,
