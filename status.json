     },
     {
      "kind": "list",
      "label": "복붙 프롬프트",
      "title": "이렇게 시켜요",
      "items": [
       {
        "h": "하려는 일 한 줄",
        "d": "목표를 먼저 고정해요"
       },
       {
        "h": "정한 것 · 못 정한 것",
        "d": "남은 숙제가 한눈에 보여요"
       },
       {
        "h": "다음에 할 일",
        "d": "새 대화 첫 줄에 그대로 붙여요"
       }
      ]
     }
