    "format": "howto",
    "type": "carousel",
    "hook": "보고 들어가기 전, 임원 질문 대비하셨나요? 보고서를 AI에 붙이고",
    "status": "scheduled",
    "link": null,
    "cards": [
     "https://raw.githubusercontent.com/shiftaimagazine/shift-threads/main/media/2026-11-20-0740-howto/01.png",
